# ===== GLaDOS 签到配置示例 =====
# 复制为 .env 并填入真实值；青龙面板请直接在「环境变量」页面添加。

# 【必填】GLaDOS 账号 Cookie
# 获取方法：登录 https://glados.cloud -> 进入签到页 -> F12 打开开发者工具
#          -> Network 标签 -> 点一次签到 -> 找到 checkin 请求
#          -> Request Headers 里的 Cookie，整段复制过来（不要手工挑字段）
#
# 注意：2026-09 起会话改用 gld:sess / gld:sess.sig 两个新字段，
#      两个都要有，缺一个就签到失败（返回「没有权限」code=-2）。
#      旧的 koa:sess / koa:sess.sig 即使没过期也不够用了。
#      完整 Cookie 里新旧字段是同时下发的，所以整段复制即可。
# 示例（gld 与 koa 通常同时存在）：
#   gld:sess=xxxxx; gld:sess.sig=yyyyy; koa:sess=zzzzz; koa:sess.sig=wwwww
# 多账号用 & 或换行分隔
GLADOS_COOKIE="gld:sess=你的会话ID; gld:sess.sig=你的会话签名"

# 【重要】登录浏览器的 User-Agent
# GLaDOS 从 2026-09 起校验设备：服务端从 UA 解析出平台，与登录时的平台比对，
# 不一致返回 code=4 (device-mismatch / Automated check-in detected)。
#
# 关键：只比对「平台」，不比对完整字符串。平台只有这几种取值：
#   Windows / macOS / Linux / Android / iOS / Bot / Other
# 所以 Chrome 版本号无所谓，只有平台必须对上。
#
# 怎么拿：用你平时登录 GLaDOS 的那个浏览器打开 glados.cloud，
#         F12 -> Console，执行 navigator.userAgent，把输出原样粘贴到这里。
#
# 要不要配：
#   Windows 电脑的 Chrome/Edge 登录 -> 不用配，下面的默认值就是 Windows Chrome
#   macOS / Linux / 手机 / iPad 登录  -> 必须改，否则会被判为自动签到
# 留空则使用内置的 Windows Chrome UA。
GLADOS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# 【可选】自定义候选域名，逗号分隔
# 默认依次尝试 glados.cloud / glados.rocks / glados.network
# GLADOS_DOMAINS="https://glados.cloud,https://glados.rocks"

# 【可选】签到 token 覆盖值，默认取首个域名（glados.cloud）
# 仅当 GLaDOS 再次更换 API 值时才需要手动设置
# GLADOS_CHECKIN_TOKEN="glados.cloud"

# 【可选】自动积分兑换档位：plan100 / plan200 / plan500 / off
#   plan100 = 100分 → 10天
#   plan200 = 200分 → 30天
#   plan500 = 500分 → 100天
# 默认 off（关闭）。开启后每次签到完自动检查积分，达标即兑换。
EXCHANGE_PLAN="off"

# 【可选】推送渠道
# PushPlus 微信推送 https://www.pushplus.plus
PUSHPLUS_TOKEN=""
# Telegram 推送
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 【可选】推送级别：fail_only（默认，仅失败时推送）/ all（每次都推送）
PUSH_LEVEL="fail_only"

# 【可选】网络与重试
GLADOS_TIMEOUT_MS="15000"
GLADOS_RETRIES="3"
GLADOS_RETRY_DELAY_MS="20000"

# 【可选】调试日志
GLADOS_VERBOSE="false"