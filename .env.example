# ===== GLaDOS 签到配置示例 =====
# 复制为 .env 并填入真实值；青龙面板请直接在「环境变量」页面添加。

# 【必填】GLaDOS 账号 Cookie
# 获取方法：登录 https://glados.cloud -> 进入签到页 -> F12 打开开发者工具
#          -> Network 标签 -> 点一次签到 -> 找到 checkin 请求
#          -> Request Headers 里的 Cookie，整段复制过来
# 格式必须为: koa:sess=xxxxx; koa:sess.sig=yyyyy
# 多账号用 & 或换行分隔
GLADOS_COOKIE="koa:sess=你的长字符串; koa:sess.sig=你的短字符串"

# 【重要】与获取 Cookie 时相同的浏览器 User-Agent
# GLaDOS 从 2026-09 起校验设备：签到请求的平台必须与登录时的平台一致，
# 否则返回 code=4 (device-mismatch)。如果你在 Windows 上登录，就保持 Windows UA。
# 留空则使用内置的 Windows Chrome UA。
GLADOS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# 【可选】自定义候选域名，逗号分隔
# 默认依次尝试 glados.cloud / glados.rocks / glados.network
# GLADOS_DOMAINS="https://glados.cloud,https://glados.rocks"

# 【可选】签到 token 覆盖值，默认取首个域名（glados.cloud）
# 仅当 GLaDOS 再次更换 API 值时才需要手动设置
# GLADOS_CHECKIN_TOKEN="glados.cloud"

# 【可选】自动积分兑换档位：plan100 / plan200 / plan500 / off
#   plan100 = 100分 → 10天
#   plan200 = 200分 → 30天
#   plan500 = 500分 → 100天
# 默认 off（关闭）。开启后每次签到完自动检查积分，达标即兑换。
EXCHANGE_PLAN="off"

# 【可选】推送渠道
# PushPlus 微信推送 https://www.pushplus.plus
PUSHPLUS_TOKEN=""
# Telegram 推送
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 【可选】推送级别：fail_only（默认，仅失败时推送）/ all（每次都推送）
PUSH_LEVEL="fail_only"

# 【可选】网络与重试
GLADOS_TIMEOUT_MS="15000"
GLADOS_RETRIES="3"
GLADOS_RETRY_DELAY_MS="20000"

# 【可选】调试日志
GLADOS_VERBOSE="false"